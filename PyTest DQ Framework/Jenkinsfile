pipeline {
	agent any

	options {
		timestamps()
		disableConcurrentBuilds()
	}

	stages {
		stage('Update packages') {
			steps {
				sh 'apt-get update'
				sh 'apt-get install -y libpq-dev'
			}
		}

		stage('Install Python') {
			steps {
				sh '''
					apt-get install -y python3 python3-pip python3-venv
					python3 --version
				'''
			}
		}

		stage('Install dependencies') {
			steps {
				dir('PyTest DQ Framework') {
					sh '''
						python3 -m venv .venv
						. .venv/bin/activate
						python -m pip install --upgrade pip
						python -m pip install -r requirements.txt
					'''
				}
			}
		}

		stage('Run Parquet DQ suite') {
			steps {
				dir('PyTest DQ Framework') {
					sh '''
						. .venv/bin/activate
						export PYTHONPATH="$WORKSPACE${PYTHONPATH:+:$PYTHONPATH}"
						mkdir -p html_report
						python -m pytest tests -m "parquet_data" \\
							--html=html_report/report.html
					'''
				}
			}
		}
	}

	post {
		always {
			dir('PyTest DQ Framework') {
				archiveArtifacts artifacts: 'html_report/**', allowEmptyArchive: true
				publishHTML(target: [
					allowMissing: true,
					alwaysLinkToLastBuild: true,
					keepAll: true,
					reportDir: 'html_report',
					reportFiles: 'report.html',
					reportName: 'Parquet DQ Report',
					reportTitles: 'Parquet DQ Results'
				])
			}
		}
	}
}
