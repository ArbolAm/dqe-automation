pipeline {
	agent any

	options {
		timestamps()
		disableConcurrentBuilds()
	}

	stages {
		stage('Update packages') {
			steps {
				sh 'apt-get update'
				sh 'apt-get install -y libpq-dev'
			}
		}

		stage('Install Python') {
			steps {
				sh '''
					apt-get install -y python3 python3-pip python3-venv
					python3 --version
				'''
			}
		}

		stage('Install dependencies') {
			steps {
				dir('PyTest DQ Framework') {
					sh '''
						python3 -m venv .venv
						. .venv/bin/activate
						python -m pip install --upgrade pip
						python -m pip install -r requirements.txt
					'''
				}
			}
		}

		stage('Run Parquet DQ suite') {
			steps {
				dir('PyTest DQ Framework') {
					catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE', catchInterruptions: false) {
						sh '''
							. .venv/bin/activate
							export PYTHONPATH="$WORKSPACE${PYTHONPATH:+:$PYTHONPATH}"
							mkdir -p html_report
							set +x
							DB_HOST=$(python -c 'from data_dev.config import postgres_config; print(postgres_config.host)')
							DB_PORT=$(python -c 'from data_dev.config import postgres_config; print(postgres_config.port)')
							DB_NAME=$(python -c 'from data_dev.config import postgres_config; print(postgres_config.db)')
							DB_USER=$(python -c 'from data_dev.config import postgres_config; print(postgres_config.user)')
							DB_PASSWORD=$(python -c 'from data_dev.config import postgres_config; print(postgres_config.password)')
							python -m pytest tests -m "parquet_data" \\
								--db_host="$DB_HOST" \\
								--db_port="$DB_PORT" \\
								--db_name="$DB_NAME" \\
								--db_user="$DB_USER" \\
								--db_password="$DB_PASSWORD" \\
								--html=html_report/report.html
						'''
					}
				}
			}
		}
	}

	post {
		always {
			dir('PyTest DQ Framework') {
				archiveArtifacts artifacts: 'html_report/**', allowEmptyArchive: true
			}
		}
	}
}
