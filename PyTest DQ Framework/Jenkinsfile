pipeline {
	agent any

	options {
		timestamps()
		disableConcurrentBuilds()
	}

	environment {
		DB_HOST = 'postgres'
		DB_PORT = '5432'
		DB_NAME = 'mydatabase'
	}

	stages {
		stage('Update packages') {
			steps {
				sh 'apt-get update'
				sh 'apt-get install -y libpq-dev'
			}
		}

		stage('Install Python') {
			steps {
				sh '''
					apt-get install -y python3 python3-pip python3-venv
					python3 --version
				'''
			}
		}

		stage('Install dependencies') {
			steps {
				dir('PyTest DQ Framework') {
					sh '''
						python3 -m venv .venv
						. .venv/bin/activate
						python -m pip install --upgrade pip
						python -m pip install -r requirements.txt
					'''
				}
			}
		}

		stage('Run Parquet DQ suite') {
			steps {
				dir('PyTest DQ Framework') {
					catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE', catchInterruptions: false) {
						withCredentials([usernamePassword(
							credentialsId: 'POSTGRES_SECRET',
							usernameVariable: 'DB_USER',
							passwordVariable: 'DB_PASSWORD'
						)]) {
							sh '''
								. .venv/bin/activate
								mkdir -p html_report
								set +x
								python -m pytest tests -m "parquet_data" \\
									--db_host="$DB_HOST" \\
									--db_port="$DB_PORT" \\
									--db_name="$DB_NAME" \\
									--db_user="$DB_USER" \\
									--db_password="$DB_PASSWORD" \\
									--html=html_report/report.html
							'''
						}
					}
				}
			}
		}
	}

	post {
		always {
			dir('PyTest DQ Framework') {
				archiveArtifacts artifacts: 'html_report/**', allowEmptyArchive: true
				publishHTML(target: [
					allowMissing: true,
					alwaysLinkToLastBuild: true,
					keepAll: true,
					reportDir: 'html_report',
					reportFiles: 'report.html',
					reportName: 'Parquet DQ Report',
					reportTitles: 'Parquet DQ Results'
				])
			}
		}
	}
}
